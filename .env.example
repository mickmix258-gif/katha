DATABASE_URL="file:./dev.db"
OPENAI_COMPAT_BASE_URL=""
OPENAI_COMPAT_API_KEY=""

# Server-only image generation (never expose to client / never commit real values)
FAL_KEY=""
# Optional override; default fal-ai/flux/schnell
IMAGE_GEN_MODEL="fal-ai/flux/schnell"

# Auth.js / NextAuth v5 — generate AUTH_SECRET with: openssl rand -base64 32
# Without these, app still builds; login shows Thai "OAuth not configured".
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# X (Twitter) OAuth 2.0 app credentials
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""
# Optional on Vercel (trustHost is enabled in auth.ts)
# AUTH_URL="https://your-domain.vercel.app"
# AUTH_TRUST_HOST="true"

# Optional durable rate-limit + server wallet (Upstash Redis REST)
# If unset: in-memory Map fallback (best-effort on multi-instance)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Developer studio gate (password for /dev/studio + GET /api/telemetry/events)
# Generate: openssl rand -hex 24 — never commit the real value
DEV_STUDIO_KEY=""

